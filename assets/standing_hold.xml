<mujoco model="Digit standing hold">
  <include file="digit-v3.xml"/>
  <!-- Reduce numerical creep at the frictional palm contacts. -->
  <option cone="elliptic" impratio="10" noslip_iterations="3"/>
  <statistic center="0.1 0 0.8" extent="1.5"/>
  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".5 .5 .5" specular=".2 .2 .2"/>
    <global azimuth="135" elevation="-15"/>
  </visual>
  <worldbody>
    <light pos="0 -2 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="3 3 .1" contype="1" conaffinity="15"
          condim="3" friction="1 .005 .0001" rgba=".22 .27 .32 1"/>
    <!-- Explicit inertia: visual geometry must not add inferred payload mass. -->
    <body name="held-box" pos=".35 0 1.1">
      <freejoint name="held-box"/>
      <inertial pos="0 0 0" mass="1" diaginertia=".0181333333 .0133333333 .0218666667"/>
      <geom name="held-box" type="box" size=".16 .20 .12" contype="4" conaffinity="15"
            condim="4" friction=".7 .01 .0001" solref=".01 1" rgba=".65 .42 .20 1"/>
    </body>
  </worldbody>
</mujoco>
